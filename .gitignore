# Python virtual environment (recreate with: python3 -m venv .venv && pip install -r requirements.txt)
.venv/

# Python cache files
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Editor settings
.vscode/

# Setup check (not part of the project)
check_setup.py
setup_test.png

# Cached lookup tables (regenerated by main.py). Two derived tables are tracked so that a fresh
# clone does not rebuild them (minutes); main.py checks their key and rebuilds them if params change.
data/*
!data/revisit_table.npz
!data/iride_coverage.npz

# Raw TLE files from CelesTrak (not redistributed; the derived CSV in inputs/ is tracked)
inputs/tle/

# Raw GCAT launch list (J. McDowell); counts are copied into params.py
inputs/launch_log/

# Figures of the default fast mode (python main.py); figures/ holds the --full figures
figures_fast/
